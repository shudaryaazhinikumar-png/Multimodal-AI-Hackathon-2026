# ============================================================
# AI Study Companion - Backend Environment Configuration
# ============================================================

# Django Security and Host Settings
DJANGO_SECRET_KEY=your-secure-django-secret-key-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Leave unset or empty to use local development SQLite (db.sqlite3).
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/study_companion
DATABASE_URL=

# CORS and CSRF Origins (Frontend Dev Server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ChromaDB Vector Store Persistence
CHROMA_PERSIST_DIRECTORY=chroma_db

# AI / LLM Provider Configuration
# Supported providers: GEMINI, GROQ, OPENAI
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Secondary / Fallback Providers
GROQ_API_KEY=
OPENAI_API_KEY=
